# ============================================================
# StudyTrade Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# Zerodha Kite (optional — only needed for live data / paper trading)
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
KITE_ACCESS_TOKEN=

# Upstox (alternative broker — optional)
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_ACCESS_TOKEN=

# General
LOG_LEVEL=INFO
